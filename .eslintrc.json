{
  "env": {
    "node": true,
    "commonjs": true,
    "es2021": true,
    "mocha": true
  },
  "globals": {
    "browser": "readonly",
    "$": "readonly",
    "$$": "readonly",
    "expect": "readonly"
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "class-methods-use-this": "off",
    "arrow-parens": "off",
    "prefer-arrow-callback": "off",
    "func-names": "off",
    "object-curly-newline": "off",
    "max-len": ["error", { "code": 120 }],
    "no-console": "off"
  }
}
